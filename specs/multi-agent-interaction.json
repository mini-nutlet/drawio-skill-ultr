{
  "meta": {
    "name": "Multi-Agent Interaction Flow",
    "diagramType": "flowchart",
    "direction": "TB",
    "theme": "blueprint",
    "mode": "light",
    "canvas": "ppt-16:9",
    "zoneMode": "divider",
    "title": "Multi-Agent Interaction Flow",
    "description": "4-layer multi-agent collaborative workflow with orchestrator, parallel agents, tools, and human-in-the-loop"
  },
  "zones": [
    { "id": "zone-hub", "layer": "hub", "label": "Hub" },
    { "id": "zone-orch", "layer": "orchestrator", "label": "Orchestrator" },
    { "id": "zone-agents", "layer": "agents", "label": "Agent Pool" },
    { "id": "zone-tools", "layer": "tools", "label": "Tools & Knowledge" },
    { "id": "zone-user", "layer": "user", "label": "User / Output" }
  ],
  "nodes": [
    { "id": "n-dispatcher", "label": "Dispatcher", "layer": "hub", "shape": "hexagon", "width": 130, "height": 55, "fillColor": "#FEF3C7", "strokeColor": "#D97706", "fontColor": "#92400E" },
    { "id": "n-analyzer", "label": "Intent Analyzer", "layer": "orchestrator", "semantic": "compute" },
    { "id": "n-planner", "label": "Task Planner", "layer": "orchestrator", "semantic": "compute" },
    { "id": "n-decompose", "label": "Decompose Task?", "layer": "orchestrator", "shape": "rhombus", "width": 120, "height": 80, "fillColor": "#FEF3C7", "strokeColor": "#D97706", "fontColor": "#92400E" },
    { "id": "n-aggregator", "label": "Result Aggregator", "layer": "orchestrator", "semantic": "compute" },
    { "id": "n-research", "label": "Research Agent", "layer": "agents", "semantic": "compute", "width": 200, "height": 60 },
    { "id": "n-planning", "label": "Planning Agent", "layer": "agents", "semantic": "compute", "width": 200, "height": 60 },
    { "id": "n-coding", "label": "Coding Agent", "layer": "agents", "semantic": "compute", "width": 200, "height": 60 },
    { "id": "n-review", "label": "Review Agent", "layer": "agents", "semantic": "security", "width": 200, "height": 60 },
    { "id": "n-sharedmem", "label": "Shared Memory", "layer": "agents", "shape": "cylinder3", "width": 120, "height": 70 },
    { "id": "n-websearch", "label": "Web Search", "layer": "tools", "shape": "step", "width": 130, "height": 55 },
    { "id": "n-codeexec", "label": "Code Executor", "layer": "tools", "shape": "step", "width": 130, "height": 55 },
    { "id": "n-vectordb", "label": "Vector Database", "layer": "tools", "shape": "cylinder3", "width": 130, "height": 65 },
    { "id": "n-git", "label": "Git Repository", "layer": "tools", "shape": "cylinder3", "width": 130, "height": 65 },
    { "id": "n-apidoc", "label": "API Documentation", "layer": "tools", "shape": "step", "width": 130, "height": 55 },
    { "id": "n-user", "label": "User", "layer": "user", "shape": "umlActor", "width": 30, "height": 60 },
    { "id": "n-task", "label": "Task / Query", "layer": "user", "shape": "ellipse", "width": 120, "height": 50, "fillColor": "#DCFCE7", "strokeColor": "#16A34A", "fontColor": "#166534" },
    { "id": "n-context", "label": "Context / Preferences", "layer": "user", "shape": "cylinder3", "width": 110, "height": 60 },
    { "id": "n-human", "label": "Human Review?", "layer": "user", "shape": "rhombus", "width": 120, "height": 80, "fillColor": "#FEF3C7", "strokeColor": "#D97706", "fontColor": "#92400E" },
    { "id": "n-final", "label": "Final Response", "layer": "user", "shape": "ellipse", "width": 120, "height": 50, "fillColor": "#DCFCE7", "strokeColor": "#16A34A", "fontColor": "#166534" }
  ],
  "groups": [
    { "id": "grp-orch", "label": "Orchestrator", "nodes": ["n-dispatcher", "n-analyzer", "n-planner", "n-decompose", "n-aggregator"], "fill": "#EFF6FF", "stroke": "#2563EB" },
    { "id": "grp-agents", "label": "Agent Pool", "nodes": ["n-research", "n-planning", "n-coding", "n-review", "n-sharedmem"], "fill": "#F5F3FF", "stroke": "#7C3AED" },
    { "id": "grp-tools", "label": "Tools", "nodes": ["n-websearch", "n-codeexec", "n-vectordb", "n-git", "n-apidoc"], "fill": "#FFF7ED", "stroke": "#EA580C" },
    { "id": "grp-user", "label": "User & Output", "nodes": ["n-user", "n-task", "n-context", "n-human", "n-final"], "fill": "#F0FDF4", "stroke": "#16A34A" }
  ],
  "edges": [
    { "id": "e1", "from": "n-user", "to": "n-task", "type": "sync-call" },
    { "id": "e2", "from": "n-task", "to": "n-analyzer", "type": "sync-call" },
    { "id": "e3", "from": "n-context", "to": "n-analyzer", "type": "data-flow" },
    { "id": "e4", "from": "n-analyzer", "to": "n-planner", "type": "sync-call" },
    { "id": "e5", "from": "n-planner", "to": "n-decompose", "type": "sync-call" },
    { "id": "e6", "from": "n-decompose", "to": "n-dispatcher", "type": "sync-call", "label": "parallel" },
    { "id": "e7", "from": "n-dispatcher", "to": "n-planning", "type": "sync-call", "label": "plan" },
    { "id": "e8", "from": "n-dispatcher", "to": "n-research", "type": "sync-call", "label": "research" },
    { "id": "e9", "from": "n-dispatcher", "to": "n-coding", "type": "sync-call", "label": "implement" },
    { "id": "e10", "from": "n-dispatcher", "to": "n-review", "type": "sync-call", "label": "review" },
    { "id": "e11", "from": "n-planning", "to": "n-research", "type": "conditional", "label": "task spec" },
    { "id": "e12", "from": "n-planning", "to": "n-coding", "type": "conditional", "label": "tasks" },
    { "id": "e13", "from": "n-coding", "to": "n-review", "type": "sync-call", "label": "code diff" },
    { "id": "e14", "from": "n-research", "to": "n-sharedmem", "type": "data-flow" },
    { "id": "e15", "from": "n-planning", "to": "n-sharedmem", "type": "data-flow" },
    { "id": "e16", "from": "n-coding", "to": "n-sharedmem", "type": "data-flow" },
    { "id": "e17", "from": "n-review", "to": "n-sharedmem", "type": "data-flow" },
    { "id": "e18", "from": "n-research", "to": "n-websearch", "type": "data-flow" },
    { "id": "e19", "from": "n-coding", "to": "n-codeexec", "type": "data-flow" },
    { "id": "e20", "from": "n-research", "to": "n-vectordb", "type": "data-flow" },
    { "id": "e21", "from": "n-coding", "to": "n-git", "type": "data-flow" },
    { "id": "e22", "from": "n-review", "to": "n-git", "type": "data-flow" },
    { "id": "e23", "from": "n-aggregator", "to": "n-human", "type": "sync-call" },
    { "id": "e24", "from": "n-human", "to": "n-final", "type": "sync-call", "label": "Approved" },
    { "id": "e25", "from": "n-human", "to": "n-planner", "type": "error-fallback", "label": "Revise" }
  ]
}
